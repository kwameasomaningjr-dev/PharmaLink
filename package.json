{
  "name": "pharmalink",
  "version": "1.0.0",
  "type": "module",
  "description": "Ghana-first digital pharmacy availability and ordering platform MVP",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:frontend && tsc",
    "build:frontend": "esbuild public/app.jsx --bundle --platform=browser --format=iife --target=es2020 --outfile=public/app.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/database/seed.ts"
  },
  "keywords": [
    "pharmacy",
    "availability",
    "ghana",
    "accra",
    "medicine-search"
  ],
  "author": "PharmaLink Engineering",
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^13.4.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.48.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
