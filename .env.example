# PharmaLink Environment Configuration
NODE_ENV=development
PORT=4000

# Auth & Security (required >= 32 chars unique random secret in production)
JWT_SECRET=pharmalink_dev_jwt_secret_key_change_in_production_min_32_chars
CORS_ORIGIN=*
APP_URL=http://localhost:4000
TRUST_PROXY_HOPS=1
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# Database: leave DATABASE_URL empty in dev for embedded PGlite.
# REQUIRED in production (Render / Railway / Neon / Supabase PostgreSQL in EU-West):
DATABASE_URL=
# Optional SSL overrides for Postgres (set DATABASE_SSL_REJECT_UNAUTHORIZED=true with valid CA)
# DATABASE_SSL=disable
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Private Object Storage (Cloudflare R2 or AWS S3) for Rx & Pharmacy Compliance Docs.
# When omitted in dev/test, files store locally in UPLOAD_DIR (./uploads).
UPLOAD_DIR=./uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Paystack Fintech (MTN MoMo, Telecel Cash, AT Money, Debit Card)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
