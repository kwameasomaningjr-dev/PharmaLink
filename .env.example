# PharmaLink Environment Configuration
NODE_ENV=development
PORT=4000
JWT_SECRET=pharmalink_dev_jwt_secret_key_change_in_production_min_32_chars
# Database: leave DATABASE_URL empty or set to postgresql://user:password@localhost:5432/pharmalink
# When DATABASE_URL is not set, PharmaLink automatically boots the embedded PostgreSQL engine (PGlite)
DATABASE_URL=
UPLOAD_DIR=./uploads
CORS_ORIGIN=*
LOG_LEVEL=info
